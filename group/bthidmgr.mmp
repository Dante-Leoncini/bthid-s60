// app "Bluetooth HID": buscar, ver y olvidar los dispositivos del servidor
TARGET          bthidmgr.exe
TARGETTYPE      exe
UID             0x100039ce 0xe0d69652
VENDORID        0
CAPABILITY      None

USERINCLUDE     . ../inc ../src
SYSTEMINCLUDE   /epoc32/include /epoc32/include/app /epoc32/include/mw /epoc32/include/platform /epoc32/include/platform/mw

SOURCEPATH      .
START RESOURCE  bthidmgr.rss
HEADER
TARGETPATH      \resource\apps
LANG SC
END

START RESOURCE  bthidmgr_reg.rss
TARGETPATH      \private\10003a3f\import\apps
END

SOURCEPATH      ../src
SOURCE          manager.cpp

LIBRARY         euser.lib
LIBRARY         apparc.lib
LIBRARY         cone.lib
LIBRARY         eikcore.lib
LIBRARY         avkon.lib
LIBRARY         ws32.lib
LIBRARY         gdi.lib
LIBRARY         bafl.lib
LIBRARY         fbscli.lib
LIBRARY         eikcoctl.lib
LIBRARY         bthidhost.lib
