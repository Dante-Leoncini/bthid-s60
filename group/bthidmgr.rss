NAME	BHID

#include <eikon.rh>
#include <avkon.rsg>
#include <avkon.rh>
#include <appinfo.rh>
#include "bthidmgr.hrh"

RESOURCE RSS_SIGNATURE { }
RESOURCE TBUF { buf="BHID"; }

RESOURCE EIK_APP_INFO
{
	menubar = r_mgr_menubar;
	cba = R_AVKON_SOFTKEYS_OPTIONS_EXIT;
}

// Acerca de: version, autor y el enlace a la pagina (con el texto del enlace marcado en el mensaje). Tambien el
// cuadro de Joystick de PS3, con la direccion del telefono
RESOURCE DIALOG r_mgr_about
{
	flags = EGeneralQueryFlags | EEikDialogFlagNoBorder | EEikDialogFlagNoShadow;
	buttons = R_AVKON_SOFTKEYS_OK_EMPTY;
	items =
	{
		DLG_LINE
		{
			type = EAknCtPopupHeadingPane;
			id = EAknMessageQueryHeaderId;
			control = AVKON_HEADING { };
		},
		DLG_LINE
		{
			type = EAknCtMessageQuery;
			id = EAknMessageQueryContentId;
			control = AVKON_MESSAGE_QUERY { };
		}
	};
}

RESOURCE MENU_BAR r_mgr_menubar
{
	titles = { MENU_TITLE { menu_pane = r_mgr_menu; } };
}

// los textos los pone la app segun el idioma del telefono (DynInitMenuPaneL)
RESOURCE MENU_PANE r_mgr_menu
{
	items =
	{
		MENU_ITEM { command = EBtHidCmdPickMouse;      txt = "Choose mouse"; },
		MENU_ITEM { command = EBtHidCmdPickKeyboard;   txt = "Choose keyboard"; },
		MENU_ITEM { command = EBtHidCmdPickPad;        txt = "Add controller"; },
		MENU_ITEM { command = EBtHidCmdTests;          txt = "Tests"; cascade = r_mgr_tests_menu; },
		MENU_ITEM { command = EBtHidCmdForgetMouse;    txt = "Remove mouse"; },
		MENU_ITEM { command = EBtHidCmdForgetKeyboard; txt = "Remove keyboard"; },
		MENU_ITEM { command = EBtHidCmdForgetPads;     txt = "Remove controllers"; },
		MENU_ITEM { command = EBtHidCmdPadKeys;        txt = "Controllers as keyboard"; },
		MENU_ITEM { command = EBtHidCmdProfiles;       txt = "Choose profile"; },
		MENU_ITEM { command = EBtHidCmdPs3;            txt = "PS3 controller"; },
		MENU_ITEM { command = EBtHidCmdAbout;          txt = "About"; },
		MENU_ITEM { command = EAknCmdExit;             txt = "Exit"; }
	};
}

// perfiles del joystick como teclado: la lista de perfiles y la de botones de uno
RESOURCE MENU_BAR r_mgr_prof_menubar
{
	titles = { MENU_TITLE { menu_pane = r_mgr_prof_menu; } };
}

RESOURCE MENU_PANE r_mgr_prof_menu
{
	items =
	{
		MENU_ITEM { command = EBtHidCmdProfUse;    txt = "Assign"; },
		MENU_ITEM { command = EBtHidCmdProfEdit;   txt = "Edit"; },
		MENU_ITEM { command = EBtHidCmdProfNew;    txt = "New profile"; },
		MENU_ITEM { command = EBtHidCmdProfRename; txt = "Rename"; },
		MENU_ITEM { command = EBtHidCmdProfDelete; txt = "Delete"; }
	};
}

RESOURCE MENU_BAR r_mgr_edit_menubar
{
	titles = { MENU_TITLE { menu_pane = r_mgr_edit_menu; } };
}

RESOURCE MENU_PANE r_mgr_edit_menu
{
	items =
	{
		MENU_ITEM { command = EBtHidCmdProfKey;   txt = "Change key"; },
		MENU_ITEM { command = EBtHidCmdProfClear; txt = "Not assigned"; },
		MENU_ITEM { command = EBtHidCmdProfPad;   txt = "Other controller"; }
	};
}

// elegir de una lista (el joystick, la tecla): los renglones y el titulo los pone la app
RESOURCE AVKON_LIST_QUERY r_mgr_list_query
{
	flags = EGeneralQueryFlags;
	softkeys = R_AVKON_SOFTKEYS_OK_CANCEL;
	items =
	{
		AVKON_LIST_QUERY_DLG_LINE
		{
			control = AVKON_LIST_QUERY_CONTROL
			{
				listtype = EAknCtSinglePopupMenuListBox;
				listbox = AVKON_LIST_QUERY_LIST { };
				heading = " ";
			};
		}
	};
}

// el nombre de un perfil
RESOURCE DIALOG r_mgr_name_query
{
	flags = EGeneralQueryFlags;
	buttons = R_AVKON_SOFTKEYS_OK_CANCEL;
	items =
	{
		DLG_LINE
		{
			type = EAknCtQuery;
			id = EGeneralQuery;
			control = AVKON_DATA_QUERY
			{
				layout = EDataLayout;
				label = " ";
				control = EDWIN { flags = EEikEdwinNoHorizScrolling | EEikEdwinResizable; maxlength = 24; width = 8; lines = 1; };
			};
		}
	};
}

// si o no (borrar un perfil)
RESOURCE DIALOG r_mgr_confirm_query
{
	flags = EGeneralQueryFlags;
	buttons = R_AVKON_SOFTKEYS_YES_NO;
	items =
	{
		DLG_LINE
		{
			type = EAknCtQuery;
			id = EGeneralQuery;
			control = AVKON_CONFIRMATION_QUERY { layout = EConfirmationQueryLayout; };
		}
	};
}

RESOURCE MENU_PANE r_mgr_tests_menu
{
	items =
	{
		MENU_ITEM { command = EBtHidCmdTestMouse; txt = "Test mouse"; },
		MENU_ITEM { command = EBtHidCmdTestKeys;  txt = "Test keyboard"; },
		MENU_ITEM { command = EBtHidCmdTestPads;  txt = "Test controllers"; }
	};
}

rls_string STRING_app_caption_string "Bluetooth HID"
rls_string STRING_app_short_caption_string "BT HID"

RESOURCE LOCALISABLE_APP_INFO r_mgr_localisable_app_info
{
	short_caption = STRING_app_short_caption_string;
	caption_and_icon = CAPTION_AND_ICON_INFO
	{
		caption = STRING_app_caption_string;
		number_of_icons = 1;
		icon_file = "\\resource\\apps\\bthidmgr_icon.mif";
	};
}
